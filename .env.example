# Copy to .env and fill in. .env is gitignored.
#
# There is no instance-wide API key any more. People sign in to the dashboard
# with a password, and agents use a per-user key minted by
# `memkit api-keys create --user <handle>`.

# --- Storage --------------------------------------------------------------
MEMKIT_DATABASE_URL=postgresql://memkit@127.0.0.1:5432/memkit
MEMKIT_QDRANT_URL=http://127.0.0.1:6333

# Stored query identities are HMAC'd with this, so rotating it makes existing
# retrieval telemetry unreadable rather than merely stale. At least 32 chars.
MEMKIT_TELEMETRY_HMAC_KEY=

# --- The team -------------------------------------------------------------
# Shown as the shared scope everyone belongs to. Created on first start.
MEMKIT_TEAM_NAME=Team

# --- Extraction -----------------------------------------------------------
# Default judge is Gemini 3.5 Flash-Lite through the Gemini Developer API:
# an API key alone, no GCP project and no gcloud. $0.30/$2.50 per Mtok.
# A plain AI Studio key works. GOOGLE_API_KEY and GOOGLE_VERTEX_API_KEY are
# also read, in that order after GEMINI_API_KEY.
GEMINI_API_KEY=

# Vertex AI instead of the Developer API (full GCP, ADC or a key). Leave BOTH
# empty to use the Developer API — the SDK rejects an api_key passed together
# with a location.
# VERTEX_PROJECT=
# VERTEX_LOCATION=global

# Only needed if MEMKIT_JUDGE_MODEL is a claude-* model.
ANTHROPIC_API_KEY=

# gemini-3.5-flash-lite | claude-haiku-4-5 | claude-sonnet-5 | claude-opus-5
MEMKIT_JUDGE_MODEL=gemini-3.5-flash-lite
MEMKIT_MONTHLY_COST_LIMIT_USD=15

# --- Embeddings -----------------------------------------------------------
# Changing the model or its width requires `memkit reindex`: the stored vectors
# are in the old model's space and are not comparable across the change.
MEMKIT_EMBED_MODEL=BAAI/bge-m3
MEMKIT_EMBED_DIM=1024
# local | onnx. Defaults to mps on macOS and cpu elsewhere.
# MEMKIT_EMBED_BACKEND=local
# MEMKIT_EMBED_DEVICE=cpu

# --- Service --------------------------------------------------------------
MEMKIT_HOST=127.0.0.1
MEMKIT_PORT=8077
# Binding anywhere but loopback needs this set, deliberately.
# MEMKIT_ALLOW_REMOTE=true
# Session cookies are Secure by default; turn this off only for local http.
# MEMKIT_COOKIE_SECURE=false

# Built dashboard. The Vite build writes here and FastAPI serves it at /ui/.
MEMKIT_UI_DIR=./src/memkit/web_dist
