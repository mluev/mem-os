# Copy to .env and fill in. .env is gitignored.

# Static key required in the X-API-Key header on every /v1 request.
MEMKIT_API_KEY=change-me

# --- Judge (stage 2) ------------------------------------------------------
# Default judge is Gemini 3.5 Flash-Lite through Vertex AI Express Mode:
# an API key alone, no GCP project and no gcloud. $0.30/$2.50 per Mtok.
# A plain AI Studio key works. GOOGLE_API_KEY and GOOGLE_VERTEX_API_KEY are
# also read, in that order after GEMINI_API_KEY.
GEMINI_API_KEY=

# Standard Vertex instead of Express (full GCP, ADC or a key). Leave BOTH empty
# for Express Mode — the SDK rejects an api_key passed together with a location.
# VERTEX_PROJECT=
# VERTEX_LOCATION=global

GOOGLE_API_KEY=

# Only needed if MEMKIT_JUDGE_MODEL is a claude-* model.
ANTHROPIC_API_KEY=

# gemini-3.5-flash-lite | claude-haiku-4-5 | claude-sonnet-5 | claude-opus-5
MEMKIT_JUDGE_MODEL=gemini-3.5-flash-lite

# The single owner for now. owner_id exists everywhere from day one so that
# adding a second user later is an auth change, not a data migration.
MEMKIT_OWNER_ID=u-1
MEMKIT_OWNER_NAME=mlutfullaev

MEMKIT_DB_PATH=./data/memkit.db
MEMKIT_QDRANT_URL=http://127.0.0.1:6333
MEMKIT_EMBED_MODEL=BAAI/bge-m3
MEMKIT_EMBED_DEVICE=mps
MEMKIT_HOST=127.0.0.1
MEMKIT_PORT=8077

# Built dashboard. The Vite build writes here and FastAPI serves it at /ui/.
MEMKIT_UI_DIR=./src/memkit/web_dist
# Optional comma/JSON list for an external frontend. Local Vite uses a proxy,
# so the safe default is no cross-origin access.
MEMKIT_CORS_ORIGINS=[]
MEMKIT_EXPOSE_DOCS=true

# Hard ceiling on judge spend (stage 2). One runaway loop can eat a month's
# budget in an hour, so this is enforced in code, not by watching a dashboard.
MEMKIT_MONTHLY_COST_LIMIT_USD=15.0
