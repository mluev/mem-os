<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.memkit.service</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mlutfullaev/.local/bin/uv</string>
        <string>run</string>
        <string>memkit</string>
        <string>serve</string>
    </array>

